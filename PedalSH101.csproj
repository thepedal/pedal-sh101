<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Browser display name comes from the DLL filename — must end in .NET
         so ReBuzz routes it to the managed loader. (Build §2)            -->
    <AssemblyName>Pedal SH101.NET</AssemblyName>
    <RootNamespace>PedalSH101</RootNamespace>

    <!-- Mandatory deployment hygiene (Build §1.2):
         ReBuzz only loads the .dll. Don't ship .pdb or .deps.json.       -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- Suppress harmless ReBuzz/.NET10-SDK assembly version conflicts.
         (Build §4)                                                       -->
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!-- ReBuzz install path. Override on the command line if your install
       lives elsewhere:  dotnet build -p:ReBuzzPath="D:\ReBuzz"           -->
  <PropertyGroup>
    <ReBuzzPath Condition="'$(ReBuzzPath)' == ''">C:\Program Files\ReBuzz</ReBuzzPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(ReBuzzPath)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Buzz.MachineInterface">
      <HintPath>$(ReBuzzPath)\Buzz.MachineInterface.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Preset bundle. ItemGroup form (not literal SourceFiles=) so the
       space in the filename round-trips correctly through MSBuild.
       (Build §3.5) -->
  <ItemGroup>
    <PresetBundle Include="Pedal SH101.prs.xml" />
  </ItemGroup>

  <!-- Auto-deploy after successful build. Generators go in Gear\Generators.
       The preset bundle filename matches the machine name + .prs.xml — the
       auto-load form per Build §3.1, so ReBuzz picks the presets up the
       moment the machine is dropped into a song.                           -->
  <Target Name="DeployToReBuzz" AfterTargets="Build">
    <Message Text="Deploying $(TargetFileName) → $(ReBuzzPath)\Gear\Generators\"
             Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ReBuzzPath)\Gear\Generators"
          ContinueOnError="true" />
    <Message Text="Deploying @(PresetBundle) → $(ReBuzzPath)\Gear\Generators\"
             Importance="high" />
    <Copy SourceFiles="@(PresetBundle)"
          DestinationFolder="$(ReBuzzPath)\Gear\Generators"
          ContinueOnError="true" />
  </Target>

</Project>
